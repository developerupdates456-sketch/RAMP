# DOMAIN - Set to server's LAN IP or domain name (used by nginx, FRONTEND_URL, WebSocket URL)

# For LAN access without domain: DOMAIN=192.168.0.64

# For production with domain: DOMAIN=rmm.teampresence.in

DOMAIN=
 
# ALLOWED_ORIGINS - Set per-client if you want to restrict CORS.

# If not set, CORS defaults to "*" (allows all origins - needed for LAN access).

# For production with domain: ALLOWED_ORIGINS=https://your-domain.com,http://your-domain.com

# ALLOWED_ORIGINS=
 
